//Deklarasi Library
#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#include <Servo.h>
#include <DHT.h>;
#include <SoftwareSerial.h>

//Definisi pin untuk gsm modul sim800l
SoftwareSerial SIM800L (52,53);// RX | TX
// Connect the SIM800L TX to Arduino pin 52 RX. 
