//Sensor Infrared
#define digitalInPin1 3 //IR NON LOGAM
#define digitalInPin2 4 //IR KERING

//Sensor ultrasonik untuk kepenuhan
#define trigPinlogam 5 //Kepenuhan Tray Sampah logam
